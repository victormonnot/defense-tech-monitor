# Optional. Relative paths are resolved from the project directory.
DTM_DATABASE_PATH=data/monitor.sqlite
# Minimum time between collection requests for each source.
DTM_COLLECTION_INTERVAL_MINUTES=15
# Optional public X account collection through the official API.
# Both a server-side Bearer Token and a positive monthly USD cap are required.
# An enabled collection schedule can read X sources once these are configured.
# Keep 0 until ready; also set a spending limit in console.x.com.
X_BEARER_TOKEN=
DTM_X_MONTHLY_BUDGET_USD=0
# Optional Jev classification. Add a key locally and a positive monthly USD cap,
# then explicitly enable comparison or personal selection in the interface.
TYPESAFE_API_KEY=
DTM_JEV_MONTHLY_BUDGET_USD=0
# Optional on-demand French summaries, billed separately from Jev.
# Add an OpenAI API key and a positive monthly USD cap, then use an article's
# summary button. Merely configuring a key never starts generation.
OPENAI_API_KEY=
DTM_SUMMARY_MONTHLY_BUDGET_USD=0
# Supported IDs and model-specific pricing are documented in the README.
DTM_SUMMARY_MODEL=gpt-6-luna
# HTTPS deployment only. Leave these unset for loopback-only local use.
# Configure both at runtime behind the authenticated gateway in deploy/README.md.
# DTM_PROXY_SECRET must be an independently generated 64-character hex secret.
# DTM_APP_ORIGIN=https://defense.example.com
# DTM_PROXY_SECRET=replace_with_a_random_64_character_hex_secret
# The supplied Coolify gateway enables public reading and private /admin.
# Never enable this without the matching gateway's trusted access headers.
# DTM_PUBLIC_READ_ONLY=1
