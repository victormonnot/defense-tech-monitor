# Optional. Relative paths are resolved from the project directory.
DTM_DATABASE_PATH=data/monitor.sqlite
# Minimum time between collection requests for each source.
DTM_COLLECTION_INTERVAL_MINUTES=15
# Optional Jev classification. Add a key locally and a positive monthly USD cap,
# then explicitly enable comparison or personal selection in the interface.
TYPESAFE_API_KEY=
DTM_JEV_MONTHLY_BUDGET_USD=0
