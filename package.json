{
  "name": "defense-tech-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Personal, source-first defense technology monitoring.",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "collect": "tsx --env-file-if-exists=.env.local scripts/collect.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "^3.0.1",
    "rss-parser": "3.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.8.4",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  }
}
